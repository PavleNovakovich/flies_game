10 REM HAPPY FLY - GW-BASIC VERSION FOR PAVLE NOVAKOVIC
20 REM A NEW PORT OF OUR PYTHON GAME, NOT THE LOST ORIGINAL
30 REM REQUIRES GW-BASIC WITH EGA GRAPHICS (SCREEN 7)
40 REM SEVEN CIRCLES, LAND, THEN CELEBRATE. R RESTARTS.
50 DEFDBL A-Z
60 KEY OFF: SCREEN 7: COLOR 7,0
70 PALETTE 0,7: PALETTE 7,0
80 REM ATTRIBUTE 0 IS LIGHT GRAY; ATTRIBUTE 7 IS BLACK
90 PI=4*ATN(1): TA=2*PI: NL=7: AV=3: SP=140
100 REM RESET POSITION AND STATE
110 CX=450: CY=350: RA=120: TX=CX: TY=CY+150
120 A=0: NC=0: ST=0: FX=CX+RA: FY=CY
130 REM ST: 0=FLYING, 1=LANDING, 2=HAPPY
140 SX=320/900: SY=200/700
150 PG=0: VP=1: GOSUB 2000
160 LT=TIMER
170 REM MAIN LOOP: READ KEYS, MEASURE TIME, UPDATE, DRAW
180 K$=INKEY$
190 IF K$=CHR$(27) THEN 900
200 IF K$="r" OR K$="R" THEN 100
210 TM=TIMER: DT=TM-LT
220 IF DT<0 THEN DT=DT+86400!
230 IF DT<.05 THEN 180
240 LT=TM
250 IF ST=0 THEN GOSUB 1000: GOTO 280
260 IF ST=1 THEN GOSUB 1500
280 GOSUB 2000
290 GOTO 180
900 REM ESC RETURNS TO THE GW-BASIC PROMPT
910 SCREEN 0: WIDTH 80: COLOR 7,0: CLS: KEY ON
920 END
1000 REM FLY IN A CIRCLE USING THE TOTAL ANGLE
1010 A=A+AV*DT
1020 IF A>NL*TA THEN A=NL*TA
1030 NC=INT(A/TA)
1040 FX=CX+RA*COS(A): FY=CY+RA*SIN(A)
1050 IF A>=NL*TA THEN NC=NL: ST=1
1060 RETURN
1500 REM MOVE TOWARD THE TARGET WITHOUT OVERSHOOTING
1510 DX=TX-FX: DY=TY-FY
1520 DS=SQR(DX*DX+DY*DY): MV=SP*DT
1530 IF DS<=MV THEN FX=TX: FY=TY: ST=2: RETURN
1540 FX=FX+DX/DS*MV
1550 FY=FY+DY/DS*MV
1560 RETURN
2000 REM DRAW ON A HIDDEN PAGE, THEN SHOW IT
2010 SCREEN 7,,PG,VP: CLS
2020 COLOR 7: LOCATE 2,2
2030 PRINT "Circles:";NC;"/";NL;
2040 LOCATE 24,2: PRINT "R: restart    Esc: quit";
2050 REM DRAW THE BROWN LANDING TARGET
2060 X=CINT(TX*SX): Y=CINT(TY*SY)
2070 CIRCLE (X,Y),11,6,,,.8
2080 PAINT (X,Y),6,6
2090 LINE (X-14,Y+3)-(X+14,Y+7),6,BF
2100 REM DRAW TWO WHITE WINGS AND A BLACK BODY
2110 X=CINT(FX*SX): Y=CINT(FY*SY)
2120 CIRCLE (X-3,Y-3),3,15,,,.8
2130 PAINT (X-3,Y-3),15,15
2140 CIRCLE (X+3,Y-3),3,15,,,.8
2150 PAINT (X+3,Y-3),15,15
2160 CIRCLE (X,Y),4,7,,,.8
2170 PAINT (X,Y),7,7
2180 IF ST<>2 THEN 2220
2190 COLOR 2: LOCATE 4,7
2200 PRINT "The Fly is Happy! BZZZ! YUMMY!";
2210 COLOR 7
2220 SCREEN 7,,PG,PG
2230 VP=PG: PG=1-PG
2240 RETURN
